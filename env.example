# Copy to /var/lib/valheim/env ON THE SERVER and `chmod 600` it. Never commit the real one.
SERVER_NAME=My Valheim Server
WORLD_NAME=Midgard
# Min 5 chars, and must NOT appear inside SERVER_NAME or the server refuses to start.
# Use something long and random; anyone with it can join and grief your world.
SERVER_PASS=change-me-please

# If backups are enabled, the restic repository password is a second file in
# the same directory:
#   sudo sh -c 'umask 077; head -c 32 /dev/urandom | base64 > /var/lib/valheim/restic-password'
# Keep a copy in a password manager: without it the backups are unreadable.
